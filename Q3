// Calculate simple interest given P, R, T → (P × R × T) / 100

#include <stdio.h>
int main (){
int principle;
int interest;
int time;

printf("enter the principle\n");
scanf("%d",&principle);

printf("enter the interest\n");
scanf("%d",&interest);

printf("enter the time\n");
scanf("%d",&time);

printf("The simple interest is %d\n",(principle*interest*time)/100);

    return 0;
}
